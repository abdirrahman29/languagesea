// Updated schema.prisma with language settings
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for authentication with language preferences
model User {
  id             String          @id @default(cuid())
  name           String?
  email          String          @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  level          String          @default("A1") // Current CEFR level
  
  // Language learning preferences
  learningLanguage String        @default("German") // Language they're learning
  nativeLanguage   String        @default("English") // Language they understand
  languageCode     String        @default("de")      // ISO code for learning language
  translationCode  String        @default("en")      // ISO code for native language
  
  savedTexts     SavedText[]
  practicedWords PracticedWord[]
  userProgress   UserProgress?
  languageSettings LanguageSettings?
}

// New model for detailed language settings
model LanguageSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Learning preferences
  learningLanguage      String   @default("German")
  nativeLanguage        String   @default("English")
  languageCode          String   @default("de")
  translationCode       String   @default("en")
  
  // Practice preferences
  showTranslations      Boolean  @default(true)
  autoPlayAudio         Boolean  @default(false)
  preferredVoice        String?  // For text-to-speech
  practiceReminders     Boolean  @default(true)
  dailyGoal            Int      @default(20) // Words per day
  
  // Difficulty preferences
  preferredDifficulty   String   @default("auto") // auto, easy, medium, hard
  includeConjugations   Boolean  @default(true)
  includeCases          Boolean  @default(true)
  includeGender         Boolean  @default(true)
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// User progress tracking with language-specific stats
model UserProgress {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verbsLearned      Int      @default(0)
  nounsLearned      Int      @default(0)
  adjectivesLearned Int      @default(0)
  adverbsLearned    Int      @default(0)
  textsProcessed    Int      @default(0)
  lastActive        DateTime @default(now())
  
  // Language-specific progress
  currentLanguage   String   @default("German")
  wordsPerDay       Int      @default(0)
  streak            Int      @default(0)
  totalPracticeTime Int      @default(0) // in minutes
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Rest of the schema remains the same...
model Verb {
  id                      Int             @id @default(autoincrement())
  baseForm                String
  level                   String
  infinitive              String?
  infinitiveId            Int?
  coOccurrenceBitmask     String?
  bigramsAndPositionHex   String?
  dateAdded               DateTime        @default(now())
  
  // Language specification
  language                String          @default("German")
  languageCode            String          @default("de")
  inThemes            ThemeCategoryWord[]
  conjugations            VerbConjugation[]
  practicedBy             PracticedWord[]
  extractedInTexts        ExtractedWord[]
}

model VerbConjugation {
  id          String  @id @default(cuid())
  verbId      Int
  verb        Verb    @relation(fields: [verbId], references: [id], onDelete: Cascade)
  tense       String  // "present", "past"
  mood        String  // "indicative", "subjunctive"
  number      String  // "SG", "PL"
  person      String  // "1", "2", "3"
  form        String
  formId      Int?
}

model Noun {
  id                      Int             @id @default(autoincrement())
  baseForm                String
  level                   String
  gender                  String?         // "MASC", "FEM", "NEUT"
  coOccurrenceBitmask     String?
  bigramsAndPositionHex   String?
  dateAdded               DateTime        @default(now())
  inThemes            ThemeCategoryWord[]
  // Language specification
  language                String          @default("German")
  languageCode            String          @default("de")
  
  cases                   NounCase[]
  practicedBy             PracticedWord[]
  extractedInTexts        ExtractedWord[]
}

model NounCase {
  id          String  @id @default(cuid())
  nounId      Int
  noun        Noun    @relation(fields: [nounId], references: [id], onDelete: Cascade)
  case        String  // "NOM", "ACC", "DAT", "GEN"
  gender      String  // "MASC", "FEM", "NEUT"
  number      String  // "SG", "PL"
  form        String
  formId      Int?
}

model Adjective {
  id                      Int                 @id @default(autoincrement())
  baseForm                String
  level                   String
  coOccurrenceBitmask     String?
  bigramsAndPositionHex   String?
  dateAdded               DateTime            @default(now())
  inThemes            ThemeCategoryWord[]
  // Language specification
  language                String              @default("German")
  languageCode            String              @default("de")
  
  declensions             AdjectiveDeclension[]
  comparativeForms        AdjectiveComparison[]
  practicedBy             PracticedWord[]
  extractedInTexts        ExtractedWord[]
}

model AdjectiveDeclension {
  id          String    @id @default(cuid())
  adjectiveId Int
  adjective   Adjective @relation(fields: [adjectiveId], references: [id], onDelete: Cascade)
  case        String    // "NOM", "ACC", "DAT", "GEN"
  gender      String    // "MASC", "FEM", "NEUT"
  number      String    // "SG", "PL"
  form        String
  formId      Int?
}

model AdjectiveComparison {
  id          String    @id @default(cuid())
  adjectiveId Int
  adjective   Adjective @relation(fields: [adjectiveId], references: [id], onDelete: Cascade)
  type        String    // "comparative", "superlative"
  form        String
  example     String?
}

model Adverb {
  id                      Int             @id @default(autoincrement())
  baseForm                String
  level                   String
  type                    String?         // "manner", "time", "place", "degree", etc.
  coOccurrenceBitmask     String?
  bigramsAndPositionHex   String?
  dateAdded               DateTime        @default(now())
  inThemes            ThemeCategoryWord[]
  // Language specification
  language                String          @default("German")
  languageCode            String          @default("de")
  
  comparativeForms        AdverbComparison[]
  practicedBy             PracticedWord[]
  extractedInTexts        ExtractedWord[]
}

model AdverbComparison {
  id          String  @id @default(cuid())
  adverbId    Int
  adverb      Adverb  @relation(fields: [adverbId], references: [id], onDelete: Cascade)
  type        String  // "comparative", "superlative"
  form        String
  example     String?
}

model SavedText {
  id            Int      @id @default(autoincrement())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  content      String          @db.Text
  level        String
  excerpt      String?         @db.Text
  wordCount    Int
  readingTime  Int
  dateAdded    DateTime        @default(now())
  
  // Language specification
  language     String          @default("German")
  languageCode String          @default("de")
  
  extractedWords ExtractedWord[]
  stats        TextStats?
}

model TextStats {
  id                  String    @id @default(cuid())
  savedTextId         Int         @unique
  savedText           SavedText @relation(fields: [savedTextId], references: [id], onDelete: Cascade)
  totalWords          Int
  verbs               Int
  nouns               Int
  adjectives          Int
  adverbs             Int
  newWords            Int
  practicedWords      Int
  knownFromOtherTexts Int
  levelA1             Int
  levelA2             Int
  levelB1             Int
  levelB2Plus         Int
}

model ExtractedWord {
  id            String    @id @default(cuid())
  savedTextId   Int     
  savedText     SavedText @relation(fields: [savedTextId], references: [id], onDelete: Cascade)
  baseForm      String
  originalForm  String?
  type          String    // "VERB", "NOUN", "ADJECTIVE", "ADVERB"
  level         String?
  gender        String?
  case          String?
  tense         String?
  translation   String?
  isNew         Boolean   @default(true)
  sentence      String?   @db.Text
  sentenceTranslation String? @db.Text
  isRepeat            Boolean   @default(false)
  dateAdded DateTime @default(now())
  
  // Language specification
  language      String    @default("German")
  languageCode  String    @default("de")
  
  // References to the actual word entities
  verbId        Int?
  verb          Verb?     @relation(fields: [verbId], references: [id])
  nounId        Int?
  noun          Noun?     @relation(fields: [nounId], references: [id])
  adjectiveId   Int?
  adjective     Adjective? @relation(fields: [adjectiveId], references: [id])
  adverbId      Int?
  adverb        Adverb?   @relation(fields: [adverbId], references: [id])
  isKnown  Boolean  @default(false)
}

model PracticedWord {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseForm    String
  type        String    // "VERB", "NOUN", "ADJECTIVE", "ADVERB"
  practiced   Boolean   @default(false)
  lastPracticed DateTime?
  timesCorrect Int      @default(0)
  timesWrong   Int      @default(0)
  
  // Language specification
  language    String    @default("German")
  languageCode String   @default("de")
  
  // References to the actual word entities
  verbId      Int?
  verb        Verb?     @relation(fields: [verbId], references: [id])
  nounId      Int?
  noun        Noun?     @relation(fields: [nounId], references: [id])
  adjectiveId Int?
  adjective   Adjective? @relation(fields: [adjectiveId], references: [id])
  adverbId    Int?
  adverb      Adverb?   @relation(fields: [adverbId], references: [id])
  
  @@unique([userId, baseForm, type, languageCode])
}

model WordCollocation {
  id          String   @id @default(cuid())
  firstWord   String
  secondWord  String
  strength    Float    // 0-1 value representing how strong the collocation is
  example     String?
  themes      String[] // Categories/themes this collocation belongs to
  language    String   @default("German")
  languageCode String  @default("de")
}

model ThemeCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  language    String   @default("German")
  languageCode String  @default("de")
  words       ThemeCategoryWord[]
}

model ThemeCategoryWord {
  id              String        @id @default(cuid())
  themeCategoryId String
  themeCategory   ThemeCategory @relation(fields: [themeCategoryId], references: [id], onDelete: Cascade)
  text            String
  type            String        // "VERB", "NOUN", "ADJECTIVE", "ADVERB"
  level           String
  translation     String
  gender          String?
  language        String        @default("German")
  languageCode    String        @default("de")
   verbId        Int?
  verb          Verb?       @relation(fields: [verbId], references: [id])

  nounId        Int?
  noun          Noun?       @relation(fields: [nounId], references: [id])

  adjectiveId   Int?
  adjective     Adjective?  @relation(fields: [adjectiveId], references: [id])

  adverbId      Int?
  adverb        Adverb?     @relation(fields: [adverbId], references: [id])
}